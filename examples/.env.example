# PlaceToPay sandbox credentials — set yours here and rename to `.env`.
PLACETOPAY_LOGIN=
PLACETOPAY_SECRET_KEY=

# Optional: SANDBOX (default) or PRODUCTION
PLACETOPAY_ENVIRONMENT=SANDBOX

# Optional: COLOMBIA (default) or ECUADOR
PLACETOPAY_COUNTRY=COLOMBIA

# Where this local app is reachable. Used as the returnUrl on created sessions.
PUBLIC_URL=http://localhost:8000
